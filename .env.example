# OpenAI-compatible text model configuration.
# Leave OPENAI_API_KEY empty to use the local mock fallback.
OPENAI_API_KEY=

# Optional. Use this for OpenAI-compatible providers.
# Example: https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional. Defaults to gpt-4.1-mini when empty.
AI_TEXT_MODEL=gpt-4.1-mini

# MySQL connection string used by Prisma.
DATABASE_URL=mysql://root:root@localhost:3306/ai-ppt

# 32-byte base64url key used to encrypt AI provider API keys at rest.
AI_CONFIG_ENCRYPTION_KEY=

# Comma-separated emails that should be promoted to administrators.
APP_ADMIN_EMAILS=1394996068@qq.com

# Optional comma-separated hosts allowed to access Next.js dev resources.
NEXT_ALLOWED_DEV_ORIGINS=192.168.0.117
