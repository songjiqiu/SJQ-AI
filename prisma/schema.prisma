generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// 用户角色，用于区分普通创作者和管理员。
enum UserRole {
  /// 普通用户，只能访问个人工作台和自己的数据。
  USER
  /// 管理员，可访问后台管理能力。
  ADMIN
}

/// PPT 生成项目状态。
enum DeckProjectStatus {
  /// 正在生成或后台任务尚未完成。
  GENERATING
  /// 生成完成，已具备可用结果。
  READY
  /// 生成失败，错误信息记录在项目中。
  FAILED
}

/// PPT 生成产物类型。
enum DeckAssetKind {
  /// 页面图片图层产物。
  IMAGE_LAYER
  /// 最终 PPTX 文件产物。
  PPTX
}

/// 账号级可复用图片素材审核状态。
enum ReusableImageAssetStatus {
  /// 等待审核或等待确认。
  PENDING
  /// 已通过审核，可被复用。
  APPROVED
  /// 已拒绝，不参与复用。
  REJECTED
}

/// 模板语义元素资产类型。
enum TemplateElementAssetKind {
  /// 容器组件资产。
  CONTAINER
  /// 图标资产。
  ICON
  /// 图形资产。
  SHAPE
  /// 线条资产。
  LINE
  /// 导航组件资产。
  NAVIGATION
  /// 文本样式资产。
  TEXT_STYLE
}

/// 模板语义元素资产套装范围。
enum TemplateAssetSetKind {
  /// 平台通用资产套装。
  COMMON
  /// 绑定到特定模板套装的资产。
  TEMPLATE
}

/// 模板语义元素资产审核状态。
enum TemplateAssetReviewStatus {
  /// 草稿状态，尚未提交审核。
  DRAFT
  /// 已提交，等待审核。
  PENDING_REVIEW
  /// 已通过审核，可用于检索和生成。
  APPROVED
  /// 已拒绝，需要修改后再提交。
  REJECTED
}

/// 模板语义元素资产来源。
enum TemplateAssetSource {
  /// 人工创建或维护。
  MANUAL
  /// AI 辅助生成。
  AI_GENERATED
}

/// PPT 槽位模板审核状态。
enum PptSlotTemplateReviewStatus {
  /// 草稿状态，尚未提交审核。
  DRAFT
  /// 已提交，等待审核。
  PENDING_REVIEW
  /// 已通过审核，可启用。
  APPROVED
  /// 审核要求修改。
  CHANGES_REQUESTED
  /// 已拒绝。
  REJECTED
}

/// AI 模型用途类型。
enum AiModelKind {
  /// 文本大语言模型。
  LLM
  /// 图片生成模型。
  IMAGE
  /// 向量嵌入模型。
  EMBEDDING
}

/// 用户账号表，保存登录凭据、资料、角色和账号状态。
model User {
  /// 用户主键，使用 cuid 生成。
  id                  String               @id @default(cuid())
  /// 登录邮箱，同一邮箱只能注册一个账号。
  email               String               @unique @db.VarChar(191)
  /// 用户显示名称，可由用户在账号设置中维护。
  displayName         String?              @db.VarChar(80)
  /// 用户头像访问路径，当前指向本地上传资源。
  avatarUrl           String?              @db.VarChar(2048)
  /// 登录密码哈希，不保存明文密码。
  passwordHash        String               @db.VarChar(255)
  /// 用户角色，用于控制管理端访问权限。
  role                UserRole             @default(USER)
  /// 账号启用状态，禁用后不可继续登录或访问。
  isActive            Boolean              @default(true)
  /// 账号创建时间。
  createdAt           DateTime             @default(now())
  /// 账号最后更新时间。
  updatedAt           DateTime             @updatedAt
  /// 用户登录会话列表。
  sessions            Session[]
  /// 用户维护的 AI 供应商列表。
  providers           AiProvider[]
  /// 用户维护的 AI 模型配置列表。
  aiModels            AiModelConfig[]
  /// 用户创建的 PPT 生成项目列表。
  deckProjects        DeckProject[]
  /// 用户保存的大纲草稿列表。
  outlineDrafts       DeckOutlineDraft[]
  /// 用户账号级可复用图片素材列表。
  reusableImageAssets ReusableImageAsset[]

  @@index([role, isActive])
}

/// 登录会话表，保存 HttpOnly Cookie 对应的服务端会话哈希。
model Session {
  /// 会话主键，使用 cuid 生成。
  id        String   @id @default(cuid())
  /// 所属用户 ID。
  userId    String
  /// 会话 token 的 SHA-256 哈希值。
  tokenHash String   @unique @db.VarChar(64)
  /// 会话过期时间。
  expiresAt DateTime
  /// 会话创建时间。
  createdAt DateTime @default(now())
  /// 会话所属用户。
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// AI 供应商配置表，按用户保存 OpenAI-compatible 服务地址和密钥。
model AiProvider {
  /// 供应商配置主键，使用 cuid 生成。
  id              String          @id @default(cuid())
  /// 所属用户 ID。
  userId          String
  /// 供应商显示名称。
  name            String          @db.VarChar(80)
  /// 用户内唯一的供应商标识。
  slug            String          @db.VarChar(64)
  /// OpenAI-compatible API Base URL。
  baseUrl         String          @db.VarChar(2048)
  /// 加密后的 API Key，空值表示未配置密钥。
  encryptedApiKey String?         @db.Text
  /// 是否启用该供应商。
  isEnabled       Boolean         @default(true)
  /// 供应商配置创建时间。
  createdAt       DateTime        @default(now())
  /// 供应商配置最后更新时间。
  updatedAt       DateTime        @updatedAt
  /// 供应商所属用户。
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 该供应商下的模型配置列表。
  models          AiModelConfig[]

  @@unique([userId, slug])
  @@index([userId])
}

/// AI 模型配置表，统一保存 LLM、图片和向量模型。
model AiModelConfig {
  /// 模型配置主键，使用 cuid 生成。
  id          String      @id @default(cuid())
  /// 所属用户 ID。
  userId      String
  /// 所属 AI 供应商 ID。
  providerId  String
  /// 模型用途类型。
  kind        AiModelKind
  /// 模型显示名称。
  displayName String      @db.VarChar(120)
  /// 供应商侧模型 ID。
  modelId     String      @db.VarChar(160)
  /// 默认采样温度，主要用于文本模型。
  temperature Float       @default(0.7)
  /// 是否启用该模型配置。
  isEnabled   Boolean     @default(true)
  /// 是否为该用户同类型默认模型。
  isDefault   Boolean     @default(false)
  /// 模型配置创建时间。
  createdAt   DateTime    @default(now())
  /// 模型配置最后更新时间。
  updatedAt   DateTime    @updatedAt
  /// 模型配置所属用户。
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 模型配置所属供应商。
  provider    AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, providerId, modelId])
  @@index([userId])
  @@index([providerId])
  @@index([userId, kind, isDefault])
}

/// PPT 生成项目表，保存一次从大纲到预览和 PPTX 的生成历史。
model DeckProject {
  /// 生成项目主键，使用 cuid 生成。
  id                   String            @id @default(cuid())
  /// 所属用户 ID。
  userId               String
  /// 创作模式标识，例如从想法生成或从文件生成。
  mode                 String            @db.VarChar(24)
  /// 项目生成状态。
  status               DeckProjectStatus @default(GENERATING)
  /// PPT 标题。
  title                String            @db.VarChar(120)
  /// PPT 摘要。
  summary              String            @db.VarChar(500)
  /// 原始生成输入快照。
  input                Json
  /// 统一视觉规范 JSON。
  unifiedVisualSpec    Json
  /// 内容审核结果 JSON。
  contentReview        Json
  /// 一致性检查报告 JSON。
  consistencyReport    Json
  /// 异步生成进度 JSON。
  generationProgress   Json?
  /// 最终 PPTX 产物对应的资产 ID。
  pptxAssetId          String?           @db.VarChar(191)
  /// 来源大纲草稿 ID。
  sourceOutlineDraftId String?           @db.VarChar(191)
  /// 生成失败时的错误摘要。
  generationError      String?           @db.VarChar(1000)
  /// 项目创建时间。
  createdAt            DateTime          @default(now())
  /// 项目最后更新时间。
  updatedAt            DateTime          @updatedAt
  /// 项目所属用户。
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 项目页面列表。
  slides               DeckSlide[]
  /// 项目产物资产列表。
  assets               DeckAsset[]

  @@index([userId, createdAt])
  @@index([status])
}

/// PPT 大纲草稿表，保存用户确认生成前的结构化大纲和视觉规范。
model DeckOutlineDraft {
  /// 大纲草稿主键，使用 cuid 生成。
  id                String   @id @default(cuid())
  /// 所属用户 ID。
  userId            String
  /// 创作模式标识。
  mode              String   @db.VarChar(24)
  /// 草稿标题。
  title             String   @db.VarChar(120)
  /// 草稿摘要。
  summary           String   @db.VarChar(500)
  /// 原始生成输入快照。
  input             Json
  /// 上传或解析文件的摘要 JSON。
  fileSummaries     Json
  /// 输入意图分析 JSON。
  intentAnalysis    Json?
  /// 统一视觉规范 JSON。
  unifiedVisualSpec Json
  /// 页面大纲与可展示内容 JSON。
  slides            Json
  /// 草稿创建时间。
  createdAt         DateTime @default(now())
  /// 草稿最后更新时间。
  updatedAt         DateTime @updatedAt
  /// 草稿所属用户。
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

/// PPT 页面表，保存单页内容、落版结果、图片请求和动效元数据。
model DeckSlide {
  /// 页面主键，使用 cuid 生成。
  id                   String      @id @default(cuid())
  /// 所属 PPT 生成项目 ID。
  projectId            String
  /// 页面业务 ID，用于前端和生成链路引用。
  slideId              String      @db.VarChar(80)
  /// 页面在项目中的顺序，从 0 开始。
  index                Int
  /// 页面内容 JSON。
  content              Json
  /// 语义化页面设计方案 JSON。
  pageDesign           Json?
  /// 最终页面元素 JSON。
  elements             Json
  /// 图片图层生成请求 JSON。
  imageLayerRequests   Json
  /// 已生成图片图层 JSON。
  generatedImageLayers Json
  /// Web 动效计划 JSON。
  motionPlan           Json
  /// 画布规格 JSON。
  canvas               Json
  /// 页面记录创建时间。
  createdAt            DateTime    @default(now())
  /// 页面记录最后更新时间。
  updatedAt            DateTime    @updatedAt
  /// 页面所属生成项目。
  project              DeckProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 页面关联的产物资产列表。
  assets               DeckAsset[]

  @@unique([projectId, index])
  @@index([projectId])
}

/// PPT 产物资产表，保存图片图层和 PPTX 文件的索引信息。
model DeckAsset {
  /// 资产主键，使用 cuid 生成。
  id                    String              @id @default(cuid())
  /// 所属 PPT 生成项目 ID。
  projectId             String
  /// 所属页面 ID，项目级产物可为空。
  slideId               String?
  /// 关联页面元素 ID。
  elementId             String?             @db.VarChar(80)
  /// 关联图片生成请求 ID。
  requestId             String?             @db.VarChar(100)
  /// 来源可复用图片素材 ID。
  sourceReusableAssetId String?             @db.VarChar(191)
  /// 资产类型。
  kind                  DeckAssetKind
  /// 生成或保存该资产的供应商标识。
  provider              String              @db.VarChar(80)
  /// 资产 MIME 类型。
  mimeType              String              @db.VarChar(120)
  /// 资产文件名。
  filename              String              @db.VarChar(255)
  /// 资产相对存储路径。
  relativePath          String              @db.VarChar(500)
  /// 资产鉴权访问 URL。
  publicUrl             String              @db.VarChar(2048)
  /// 资产文件大小，单位字节。
  sizeBytes             Int
  /// 资产扩展元数据 JSON。
  metadata              Json
  /// 资产创建时间。
  createdAt             DateTime            @default(now())
  /// 资产所属生成项目。
  project               DeckProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 资产所属页面。
  slide                 DeckSlide?          @relation(fields: [slideId], references: [id], onDelete: SetNull)
  /// 资产来源可复用图片素材。
  sourceReusableAsset   ReusableImageAsset? @relation(fields: [sourceReusableAssetId], references: [id], onDelete: SetNull)

  @@index([projectId, kind])
  @@index([slideId])
  @@index([sourceReusableAssetId])
}

/// 账号级可复用图片素材表，保存可复用图片缓存的元数据和质量信息。
model ReusableImageAsset {
  /// 可复用图片素材主键，使用 cuid 生成。
  id                    String                   @id @default(cuid())
  /// 所属用户 ID。
  userId                String
  /// 图片复用缓存键。
  cacheKey              String                   @db.VarChar(64)
  /// 图片素材审核状态。
  status                ReusableImageAssetStatus @default(PENDING)
  /// 图片生成供应商标识。
  provider              String                   @db.VarChar(80)
  /// 图片生成模型 ID。
  modelId               String                   @db.VarChar(160)
  /// 图片类型标识。
  imageType             String                   @db.VarChar(40)
  /// 图片宽高比。
  aspectRatio           String                   @db.VarChar(16)
  /// 是否要求透明背景。
  transparentBackground Boolean                  @default(false)
  /// 图片生成正向提示词。
  prompt                String                   @db.Text
  /// 图片生成规避内容提示词。
  avoid                 String                   @db.Text
  /// 图片关键词 JSON。
  keywords              Json
  /// 图片视觉风格说明。
  visualStyle           String                   @db.VarChar(500)
  /// 图片 MIME 类型。
  mimeType              String                   @db.VarChar(120)
  /// 图片文件名。
  filename              String                   @db.VarChar(255)
  /// 图片相对存储路径。
  relativePath          String                   @db.VarChar(500)
  /// 图片文件大小，单位字节。
  sizeBytes             Int
  /// 图片宽度，单位像素。
  width                 Int
  /// 图片高度，单位像素。
  height                Int
  /// 图片质量审核结果 JSON。
  qualityReview         Json
  /// 图片扩展元数据 JSON。
  metadata              Json
  /// 图片素材创建时间。
  createdAt             DateTime                 @default(now())
  /// 图片素材最后更新时间。
  updatedAt             DateTime                 @updatedAt
  /// 图片素材所属用户。
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 复用该图片素材的项目资产列表。
  deckAssets            DeckAsset[]

  @@unique([userId, cacheKey])
  @@index([userId, status])
}

/// PPT 模板表，保存管理员维护的全局页面模板。
model PptTemplate {
  /// 模板主键，使用 cuid 生成。
  id                 String   @id @default(cuid())
  /// 模板固定分类。
  category           String   @db.VarChar(80)
  /// 自定义分类标识预留字段。
  customCategoryKey  String?  @db.VarChar(80)
  /// 自定义分类名称预留字段。
  customCategoryName String?  @db.VarChar(120)
  /// 模板名称。
  name               String   @db.VarChar(120)
  /// 模板说明。
  description        String?  @db.VarChar(500)
  /// 模板标签 JSON。
  tags               Json
  /// 模板排序值，数值越小越靠前。
  sortOrder          Int      @default(0)
  /// 是否启用该模板。
  isEnabled          Boolean  @default(true)
  /// 完整页面模板 JSON。
  slide              Json
  /// 模板创建时间。
  createdAt          DateTime @default(now())
  /// 模板最后更新时间。
  updatedAt          DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([isEnabled])
}

/// PPT 槽位模板表，保存从 PPTX 页面提取出的可复用槽位模板。
model PptSlotTemplate {
  /// 槽位模板主键，使用 cuid 生成。
  id               String                      @id @default(cuid())
  /// 槽位模板名称。
  name             String                      @db.VarChar(120)
  /// 槽位模板说明。
  description      String?                     @db.VarChar(500)
  /// 来源 PPTX 文件名。
  sourceFile       String                      @db.VarChar(255)
  /// 来源 PPTX 页码索引。
  sourceSlideIndex Int
  /// 适用页面类型 JSON。
  pageTypes        Json
  /// 页面布局模式标识。
  layoutPattern    String                      @db.VarChar(120)
  /// 槽位模板审核状态。
  reviewStatus     PptSlotTemplateReviewStatus @default(PENDING_REVIEW)
  /// 画布规格 JSON。
  canvas           Json
  /// 安全区域 JSON。
  safeArea         Json
  /// 对齐参考线 JSON。
  alignmentLines   Json
  /// 页面槽位定义 JSON。
  slots            Json
  /// 样式令牌 JSON。
  styleTokens      Json
  /// 模板使用规则 JSON。
  rules            Json
  /// 模板使用统计 JSON。
  usage            Json
  /// 审核备注。
  reviewNotes      String?                     @db.VarChar(1000)
  /// 模板叠加预览图相对路径。
  overlayPath      String?                     @db.VarChar(500)
  /// 提取产物路径 JSON。
  artifactPaths    Json
  /// 是否启用该槽位模板。
  isEnabled        Boolean                     @default(false)
  /// 槽位模板创建时间。
  createdAt        DateTime                    @default(now())
  /// 槽位模板最后更新时间。
  updatedAt        DateTime                    @updatedAt

  @@index([reviewStatus, isEnabled])
  @@index([sourceFile, sourceSlideIndex])
  @@index([createdAt])
}

/// 模板语义资产公共主表，保存六类资产共享的治理、检索和预览字段。
model TemplateAsset {
  /// 语义资产主键，使用 cuid 生成。
  id                  String                    @id @default(cuid())
  /// 资产类型，用于公共检索和渲染绑定诊断。
  kind                TemplateElementAssetKind
  /// 资产套装范围。
  setKind             TemplateAssetSetKind      @default(COMMON)
  /// 资产套装标识。
  setKey              String                    @default("common") @db.VarChar(80)
  /// 资产套装名称。
  setName             String                    @default("通用套装") @db.VarChar(120)
  /// 资产名称。
  name                String                    @db.VarChar(120)
  /// 资产说明。
  description         String?                   @db.VarChar(500)
  /// 一级分类。
  primaryCategory     String?                   @db.VarChar(80)
  /// 二级分类。
  secondaryCategory   String?                   @db.VarChar(80)
  /// 变体标识。
  variantKey          String?                   @db.VarChar(80)
  /// 普通标签 JSON。
  tags                Json
  /// 语义标签 JSON。
  semanticTags        Json
  /// 检索关键词 JSON。
  keywords            Json
  /// 同义词 JSON。
  synonyms            Json
  /// 适用页面类型 JSON。
  pageTypes           Json
  /// 使用场景 JSON。
  usageScenarios      Json
  /// 风格标签 JSON。
  styleTags           Json
  /// 色彩标签 JSON。
  colorTags           Json
  /// 背景适配模式 JSON。
  backgroundModes     Json
  /// 管理端预览配置 JSON。
  preview             Json
  /// AI 修改权限 JSON。
  aiModifyPermissions Json
  /// 资产审核状态。
  reviewStatus        TemplateAssetReviewStatus @default(APPROVED)
  /// 资产来源。
  source              TemplateAssetSource       @default(MANUAL)
  /// 资产排序值，数值越小越靠前。
  sortOrder           Int                       @default(0)
  /// 是否启用该资产。
  isEnabled           Boolean                   @default(true)
  /// 资产创建时间。
  createdAt           DateTime                  @default(now())
  /// 资产最后更新时间。
  updatedAt           DateTime                  @updatedAt
  /// 图标资产详情。
  icon                TemplateIconAsset?
  /// 图形资产详情。
  shape               TemplateShapeAsset?
  /// 线条资产详情。
  line                TemplateLineAsset?
  /// 文本样式资产详情。
  textStyle           TemplateTextStyleAsset?
  /// 容器组件资产详情。
  container           TemplateContainerAsset?
  /// 导航组件资产详情。
  navigation          TemplateNavigationAsset?

  @@unique([setKind, setKey, kind, name])
  @@index([setKind, setKey, kind, sortOrder])
  @@index([kind, reviewStatus, isEnabled])
  @@index([kind, sortOrder])
  @@index([kind, isEnabled])
  @@index([kind, primaryCategory, secondaryCategory, variantKey], name: "TemplateAsset_category_idx")
}

/// 图标资产详情表。
model TemplateIconAsset {
  id           String        @id @default(cuid())
  assetId      String        @unique
  iconName     String        @db.VarChar(100)
  iconStyle    String        @default("line") @db.VarChar(40)
  strokeColor  String?       @db.VarChar(40)
  strokeWidth  Float?
  fillMode     String?       @db.VarChar(40)
  cornerRadius Float?
  asset        TemplateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// 图形资产详情表。
model TemplateShapeAsset {
  id           String        @id @default(cuid())
  assetId      String        @unique
  shapeType    String        @db.VarChar(80)
  fillColor    String?       @db.VarChar(40)
  strokeColor  String?       @db.VarChar(40)
  strokeWidth  Float?
  cornerRadius Float?
  opacity      Float?
  shadow       Boolean       @default(false)
  asset        TemplateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// 线条资产详情表。
model TemplateLineAsset {
  id             String        @id @default(cuid())
  assetId        String        @unique
  connectorType  String        @default("straight") @db.VarChar(80)
  direction      String        @default("horizontal") @db.VarChar(80)
  dash           String        @default("solid") @db.VarChar(40)
  startArrowType String        @default("none") @db.VarChar(80)
  endArrowType   String        @default("none") @db.VarChar(80)
  strokeColor    String?       @db.VarChar(40)
  strokeWidth    Float?
  cap            String        @default("round") @db.VarChar(40)
  asset          TemplateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// 文本样式资产详情表。
model TemplateTextStyleAsset {
  id            String        @id @default(cuid())
  assetId       String        @unique
  textRole      String        @db.VarChar(100)
  fontFamily    String?       @db.VarChar(160)
  fontSize      Float?
  fontWeight    Int?
  lineHeight    Float?
  maxLines      Int?
  color         String?       @db.VarChar(40)
  letterSpacing Float?
  asset         TemplateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// 容器组件资产详情表。
model TemplateContainerAsset {
  id                  String        @id @default(cuid())
  assetId             String        @unique
  containerRole       String        @db.VarChar(100)
  allowedContentTypes Json
  autoLayout          Boolean       @default(false)
  padding             Float?
  gap                 Float?
  recommendedWidth    Float?
  recommendedHeight   Float?
  fillColor           String?       @db.VarChar(40)
  strokeColor         String?       @db.VarChar(40)
  strokeWidth         Float?
  asset               TemplateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

/// 导航组件资产详情表。
model TemplateNavigationAsset {
  id             String        @id @default(cuid())
  assetId        String        @unique
  navigationRole String        @db.VarChar(100)
  displayMode    String        @db.VarChar(80)
  fixedPosition  String        @default("bottom") @db.VarChar(40)
  activeColor    String?       @db.VarChar(40)
  inactiveColor  String?       @db.VarChar(40)
  showOnCover    Boolean       @default(false)
  showOnEnding   Boolean       @default(false)
  asset          TemplateAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}
