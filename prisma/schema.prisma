generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum DeckProjectStatus {
  GENERATING
  READY
  FAILED
}

enum DeckAssetKind {
  IMAGE_LAYER
  PPTX
}

enum ReusableImageAssetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TemplateElementAssetKind {
  CONTAINER
  ICON
  SHAPE
  LINE
  NAVIGATION
  TEXT_STYLE
}

enum TemplateAssetSetKind {
  COMMON
  TEMPLATE
}

enum TemplateAssetReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TemplateAssetSource {
  MANUAL
  AI_GENERATED
}

enum AiModelKind {
  LLM
  IMAGE
  EMBEDDING
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique @db.VarChar(191)
  displayName  String?      @db.VarChar(80)
  avatarUrl    String?      @db.VarChar(2048)
  passwordHash String       @db.VarChar(255)
  role         UserRole     @default(USER)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  providers    AiProvider[]
  aiModels     AiModelConfig[]
  deckProjects DeckProject[]
  outlineDrafts DeckOutlineDraft[]
  reusableImageAssets ReusableImageAsset[]

  @@index([role, isActive])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AiProvider {
  id              String     @id @default(cuid())
  userId          String
  name            String     @db.VarChar(80)
  slug            String     @db.VarChar(64)
  baseUrl         String     @db.VarChar(2048)
  encryptedApiKey String?    @db.Text
  isEnabled       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  models          AiModelConfig[]

  @@unique([userId, slug])
  @@index([userId])
}

model AiModelConfig {
  id          String     @id @default(cuid())
  userId      String
  providerId  String
  kind        AiModelKind
  displayName String     @db.VarChar(120)
  modelId     String     @db.VarChar(160)
  temperature Float      @default(0.7)
  isEnabled   Boolean    @default(true)
  isDefault   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, providerId, modelId])
  @@index([userId])
  @@index([providerId])
  @@index([userId, kind, isDefault])
}

model DeckProject {
  id                    String            @id @default(cuid())
  userId                String
  mode                  String            @db.VarChar(24)
  status                DeckProjectStatus @default(GENERATING)
  title                 String            @db.VarChar(120)
  summary               String            @db.VarChar(500)
  input                 Json
  unifiedVisualSpec     Json
  contentReview         Json
  consistencyReport     Json
  generationProgress    Json?
  pptxAssetId           String?           @db.VarChar(191)
  sourceOutlineDraftId  String?           @db.VarChar(191)
  generationError       String?           @db.VarChar(1000)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slides                DeckSlide[]
  assets                DeckAsset[]

  @@index([userId, createdAt])
  @@index([status])
}

model DeckOutlineDraft {
  id                String   @id @default(cuid())
  userId            String
  mode              String   @db.VarChar(24)
  title             String   @db.VarChar(120)
  summary           String   @db.VarChar(500)
  input             Json
  fileSummaries     Json
  intentAnalysis    Json?
  unifiedVisualSpec Json
  slides            Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
}

model DeckSlide {
  id                    String       @id @default(cuid())
  projectId             String
  slideId               String       @db.VarChar(80)
  index                 Int
  content               Json
  pageDesign            Json?
  elements              Json
  imageLayerRequests    Json
  generatedImageLayers  Json
  motionPlan            Json
  canvas                Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  project               DeckProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets                DeckAsset[]

  @@unique([projectId, index])
  @@index([projectId])
}

model DeckAsset {
  id              String        @id @default(cuid())
  projectId       String
  slideId         String?
  elementId       String?       @db.VarChar(80)
  requestId       String?       @db.VarChar(100)
  sourceReusableAssetId String?  @db.VarChar(191)
  kind            DeckAssetKind
  provider        String        @db.VarChar(80)
  mimeType        String        @db.VarChar(120)
  filename        String        @db.VarChar(255)
  relativePath    String        @db.VarChar(500)
  publicUrl       String        @db.VarChar(2048)
  sizeBytes       Int
  metadata        Json
  createdAt       DateTime      @default(now())
  project         DeckProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slide           DeckSlide?    @relation(fields: [slideId], references: [id], onDelete: SetNull)
  sourceReusableAsset ReusableImageAsset? @relation(fields: [sourceReusableAssetId], references: [id], onDelete: SetNull)

  @@index([projectId, kind])
  @@index([slideId])
  @@index([sourceReusableAssetId])
}

model ReusableImageAsset {
  id                    String                   @id @default(cuid())
  userId                String
  cacheKey              String                   @db.VarChar(64)
  status                ReusableImageAssetStatus @default(PENDING)
  provider              String                   @db.VarChar(80)
  modelId               String                   @db.VarChar(160)
  imageType             String                   @db.VarChar(40)
  aspectRatio           String                   @db.VarChar(16)
  transparentBackground Boolean                  @default(false)
  prompt                String                   @db.Text
  avoid                 String                   @db.Text
  keywords              Json
  visualStyle           String                   @db.VarChar(500)
  mimeType              String                   @db.VarChar(120)
  filename              String                   @db.VarChar(255)
  relativePath          String                   @db.VarChar(500)
  sizeBytes             Int
  width                 Int
  height                Int
  qualityReview         Json
  metadata              Json
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckAssets            DeckAsset[]

  @@unique([userId, cacheKey])
  @@index([userId, status])
}

model PptTemplate {
  id                 String   @id @default(cuid())
  category           String   @db.VarChar(80)
  customCategoryKey  String?  @db.VarChar(80)
  customCategoryName String?  @db.VarChar(120)
  name               String   @db.VarChar(120)
  description        String?  @db.VarChar(500)
  tags               Json
  sortOrder          Int      @default(0)
  isEnabled          Boolean  @default(true)
  slide              Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([isEnabled])
}

model TemplateElementAsset {
  id             String                    @id @default(cuid())
  kind           TemplateElementAssetKind
  setKind        TemplateAssetSetKind      @default(COMMON)
  setKey         String                    @default("common") @db.VarChar(80)
  setName        String                    @default("通用套装") @db.VarChar(120)
  name           String                    @db.VarChar(120)
  description    String?                   @db.VarChar(500)
  primaryCategory   String?               @db.VarChar(80)
  secondaryCategory String?               @db.VarChar(80)
  variantKey        String?               @db.VarChar(80)
  tags           Json
  semanticTags   Json
  keywords       Json
  synonyms       Json
  pageTypes      Json
  usageScenarios Json
  styleTags      Json
  colorTags      Json
  backgroundModes Json
  style          Json
  preview        Json
  resource       Json
  aiModifyPermissions Json
  reviewStatus   TemplateAssetReviewStatus @default(APPROVED)
  source         TemplateAssetSource        @default(MANUAL)
  sortOrder      Int                      @default(0)
  isEnabled      Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([setKind, setKey, kind, name])
  @@index([setKind, setKey, kind, sortOrder])
  @@index([kind, reviewStatus, isEnabled])
  @@index([kind, sortOrder])
  @@index([kind, isEnabled])
  @@index([kind, primaryCategory, secondaryCategory, variantKey], name: "TemplateElementAsset_category_idx")
}
